# =============================================================================
# SecureVault Android Release Signing Configuration Example
# =============================================================================
# Copy this file to keystore.properties in the android/ directory.
# NEVER commit keystore.properties or *.jks / *.keystore files to version control!
# (Both are already ignored by .gitignore)
#
# Alternatively, configure the release signing via environment variables:
#   export SECUREVAULT_KEYSTORE_PATH="/path/to/release.keystore"
#   export SECUREVAULT_KEYSTORE_PASSWORD="your-keystore-password"
#   export SECUREVAULT_KEY_ALIAS="securevault-release"
#   export SECUREVAULT_KEY_PASSWORD="your-key-password"
# =============================================================================

storeFile=release.keystore
storePassword=replace-with-keystore-password
keyAlias=securevault-release
keyPassword=replace-with-key-password
