# =============================================================================
# SecureVault Backend — Environment Configuration Template
# =============================================================================
# Copy this file to .env (gitignored) and replace every REPLACE_WITH_* value.
# Run scripts/gen_secrets.py to generate the three cryptographic secrets:
#
#   python scripts/gen_secrets.py
#
# ROTATE all secrets immediately if this file was ever shared or committed.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# Production: must be a PostgreSQL URL (not SQLite).
SECUREVAULT_DATABASE_URL=postgresql+asyncpg://securevault:REPLACE_WITH_DB_PASSWORD@localhost:5432/securevault

# ── Cryptographic Secrets ─────────────────────────────────────────────────────
# JWT signing key — must be ≥32 bytes, high entropy. Never reuse another secret.
SECUREVAULT_JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_SECRET_SEE_gen_secrets_py

# Refresh-token HMAC key — independent from JWT_SECRET.
SECUREVAULT_REFRESH_TOKEN_HASH_SECRET=REPLACE_WITH_ANOTHER_INDEPENDENT_RANDOM_SECRET

# Step-up challenge/grant HMAC key — independent from the above two.
SECUREVAULT_STEP_UP_HASH_SECRET=REPLACE_WITH_YET_ANOTHER_INDEPENDENT_RANDOM_SECRET

# ── Google OAuth ──────────────────────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs.
# Required in production (ENVIRONMENT=production). Leave empty only in local dev.
SECUREVAULT_GOOGLE_WEB_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# ── JWT Configuration ─────────────────────────────────────────────────────────
SECUREVAULT_JWT_ISSUER=securevault-api
SECUREVAULT_JWT_AUDIENCE=securevault-android

# ── Environment ───────────────────────────────────────────────────────────────
# Set to "production" on live servers. "development" relaxes startup guards.
SECUREVAULT_ENVIRONMENT=development

# ── Device Signature Enforcement ─────────────────────────────────────────────
# Default is true in production. Override to false ONLY for local development.
SECUREVAULT_REQUIRE_DEVICE_SIGNATURE=false

# ── Redis (required in production for distributed rate limiting) ───────────────
# In production, an in-memory fallback is NOT safe across multiple API instances.
# SECUREVAULT_REDIS_URL=redis://localhost:6379/0
SECUREVAULT_REDIS_URL=

# ── S3-compatible Object Storage (optional, for encrypted blob attachments) ───
# SECUREVAULT_S3_ENDPOINT_URL=https://s3.amazonaws.com
SECUREVAULT_S3_ENDPOINT_URL=
SECUREVAULT_S3_BUCKET_NAME=securevault-blobs
# SECUREVAULT_S3_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
SECUREVAULT_S3_ACCESS_KEY_ID=
# SECUREVAULT_S3_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
SECUREVAULT_S3_SECRET_ACCESS_KEY=
SECUREVAULT_S3_REGION=auto
